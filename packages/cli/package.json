{
  "name": "@kapabl/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Kapabl CLI: compile, review, emit, dev",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "bin": {
    "kapabl": "./bin/kapabl.ts"
  },
  "dependencies": {
    "@kapabl/compiler": "workspace:*",
    "@kapabl/emitters": "workspace:*",
    "@kapabl/graph": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./audit": {
        "types": "./dist/src/audit.d.ts",
        "default": "./dist/src/audit.js"
      }
    },
    "bin": {
      "kapabl": "./dist/bin/kapabl.js"
    }
  },
  "files": [
    "dist"
  ]
}
