{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "bin"],
  "compilerOptions": {
    "types": ["node"],
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@kapabl/graph": ["../graph/dist/index.d.ts"],
      "@kapabl/compiler": ["../compiler/dist/index.d.ts"],
      "@kapabl/compiler/openapi": ["../compiler/dist/openapi.d.ts"],
      "@kapabl/emitters": ["../emitters/dist/index.d.ts"],
      "@kapabl/graph/payments": ["../graph/dist/payments.d.ts"]
