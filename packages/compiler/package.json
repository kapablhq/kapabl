{
  "name": "@kapabl/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI import and HAR scrub + structural inference",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/har-format": "1.2.16",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@kapabl/graph": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./openapi": {
        "types": "./dist/openapi.d.ts",
        "default": "./dist/openapi.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
